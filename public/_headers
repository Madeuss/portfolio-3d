# Cabeçalhos aplicados pelo Cloudflare (Workers static assets lê este arquivo).
# Mesma base do madeusdev, com o que o 3D precisa a mais:
# - 'wasm-unsafe-eval': o Rapier (física) roda em WebAssembly;
# - style-src 'unsafe-inline': estilos injetados em tempo de execução (Leva, drei Html);
# - blob:/data:: texturas e áudio decodificados pelo three.js e pelo Howler.
# A CSP está em modo Report-Only: só avisa no console, não bloqueia. Depois de
# conferir que o console fica limpo, trocar o nome para Content-Security-Policy.

/*
  Content-Security-Policy-Report-Only: default-src 'self'; script-src 'self' 'wasm-unsafe-eval' https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; img-src 'self' data: blob:; media-src 'self' blob: data:; connect-src 'self' blob: data: https://cloudflareinsights.com; worker-src 'self' blob:; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
  Cross-Origin-Opener-Policy: same-origin

# arquivos do build têm hash no nome: podem ficar em cache para sempre
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# modelos, céu, sons e imagens mudam pouco: uma semana
/models/*
  Cache-Control: public, max-age=604800
/hdri/*
  Cache-Control: public, max-age=604800
/sounds/*
  Cache-Control: public, max-age=604800
/images/*
  Cache-Control: public, max-age=604800
